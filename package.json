{
	"name": "folder-spaces",
  "version": "0.1.9",
	"description": "Create folder-scoped File Explorer spaces in Obsidian sidebars, editor tabs, and popout windows.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
		"file-explorer",
		"folder-scoped",
		"folder-spaces"
  ],
  "author": "edwardsayer",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4",
    "obsidian": "^1.12.3",
    "typescript": "^5.9.3"
  }
}
