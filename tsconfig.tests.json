{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": [
    "src/panel-activity-tracker.ts",
    "src/panel-binding.ts",
    "src/folder-space-routing-policy.ts",
    "src/compatibility-helpers.ts",
    "src/api.ts",
    "src/i18n.ts",
    "src/settings.ts",
    "src/presets.ts",
    "src/folder-space-sort-filter.ts",
    "src/folder-note-compat.ts",
    "tests/**/*.ts"
  ]
}
